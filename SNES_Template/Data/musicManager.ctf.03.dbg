.include "hdr.asm"
.accu 16
.index 16
.16bit
.define __updateMusicManager_locals 0
.define __playMusic_locals 0

.SECTION ".updateMusicManagertext_0x0" SUPERFREE

updateMusicManager:
.ifgr __updateMusicManager_locals 0
tsa
sec
sbc #__updateMusicManager_locals
tas
.endif
jsr.l spcProcess
jsr.l WaitForVBlank
.ifgr __updateMusicManager_locals 0
tsa
clc
adc #__updateMusicManager_locals
tas
.endif
rtl
.ENDS

.SECTION ".playMusictext_0x1" SUPERFREE

playMusic:
.ifgr __playMusic_locals 0
tsa
sec
sbc #__playMusic_locals
tas
.endif
lda 3 + __playMusic_locals + 1,s
pha
jsr.l spcLoad
pla
pea.w 0
jsr.l spcPlay
pla
.ifgr __playMusic_locals 0
tsa
clc
adc #__playMusic_locals
tas
.endif
rtl
.ENDS
.RAMSECTION "ram{WLA_FILENAME}.data" APPENDTO "globram.data"

.ENDS

.SECTION "{WLA_FILENAME}.data" APPENDTO "glob.data"

.ENDS

.SECTION ".rodata" SUPERFREE

.ENDS

.RAMSECTION ".bss" BANK $7e SLOT 2
.ENDS
