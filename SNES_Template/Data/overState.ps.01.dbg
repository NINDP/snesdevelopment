.include "hdr.asm"
.accu 16
.index 16
.16bit
.define __OverStart_locals 0
.define __OverUpdate_locals 0
.define __OverDraw_locals 0
.define __OverEnd_locals 0

.SECTION ".OverStarttext_0x0" SUPERFREE

OverStart:
; sub sp,#__OverStart_locals
.ifgr __OverStart_locals 0
tsa
sec
sbc #__OverStart_locals
tas
.endif
; gsym_addr t 0 a 152 ind 152
; ERROR no jump found to patch
; add sp, #__OverStart_locals
.ifgr __OverStart_locals 0
tsa
clc
adc #__OverStart_locals
tas
.endif
rtl
.ENDS

