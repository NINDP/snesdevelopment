CC ?= cc
CFLAGS := -std=c99 -O2 -Wall -Wextra -Werror -IData/include
CORE := Data/core/sneskit.c Data/core/game.c Data/core/light.c Data/core/perspective.c Data/content/perspective.c Data/content/story.c Data/content/beam.c
.PHONY: test sanitize
build:
	mkdir -p build
build/test_core: tests/test_core.c $(CORE) Data/include/game.h | build
	$(CC) $(CFLAGS) $(CORE) $< -o $@
test: build/test_core
	./build/test_core
sanitize: | build
	$(CC) $(CFLAGS) -O1 -g -fsanitize=address,undefined $(CORE) tests/test_core.c -o build/test_sanitize
	ASAN_OPTIONS=detect_leaks=0 ./build/test_sanitize
